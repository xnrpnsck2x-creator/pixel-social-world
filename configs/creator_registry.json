{
  "schema_version": 1,
  "revision": "2026-07-25.2",
  "default_locale": "en",
  "modes": [
    {
      "id": "casual_activity",
      "public_runtime_enabled": true,
      "min_players": 1,
      "max_players": 4,
      "runtime_contract": {
        "camera": "contained",
        "input_profile": "tap_timing",
        "network_profile": "offline_optional"
      },
      "capabilities": [
        "cap.timer.local",
        "cap.score.submit",
        "cap.emote.request"
      ]
    },
    {
      "id": "side_scroller_2d",
      "public_runtime_enabled": false,
      "min_players": 1,
      "max_players": 4,
      "runtime_contract": {
        "camera": "side_view",
        "input_profile": "action_platformer",
        "network_profile": "session_sync"
      },
      "capabilities": [
        "cap.character.physics",
        "cap.world.tilemap",
        "cap.camera.2d",
        "cap.enemy.ai",
        "cap.emote.request"
      ]
    },
    {
      "id": "2d_fighting",
      "public_runtime_enabled": false,
      "min_players": 1,
      "max_players": 4,
      "runtime_contract": {
        "camera": "side_view",
        "input_profile": "fighting_action",
        "network_profile": "authoritative_realtime"
      },
      "capabilities": [
        "cap.character.physics",
        "cap.combat.hitboxes",
        "cap.combat.hurtboxes",
        "cap.input.buffer",
        "cap.combat.combo_rules",
        "cap.session.round_timer",
        "cap.emote.request"
      ]
    },
    {
      "id": "strategy_war",
      "public_runtime_enabled": false,
      "min_players": 1,
      "max_players": 4,
      "runtime_contract": {
        "camera": "isometric",
        "input_profile": "strategy_pointer",
        "network_profile": "turn_or_lockstep"
      },
      "capabilities": [
        "cap.strategy.grid_state",
        "cap.strategy.unit_orders",
        "cap.strategy.projectiles",
        "cap.strategy.fog_of_war"
      ]
    },
    {
      "id": "rpg_adventure",
      "public_runtime_enabled": false,
      "min_players": 1,
      "max_players": 4,
      "runtime_contract": {
        "camera": "top_down",
        "input_profile": "rpg_move_confirm",
        "network_profile": "session_sync"
      },
      "capabilities": [
        "cap.rpg.dialogue",
        "cap.rpg.quests",
        "cap.rpg.inventory_light",
        "cap.rpg.combat_light",
        "cap.emote.request"
      ]
    },
    {
      "id": "tower_defense",
      "public_runtime_enabled": false,
      "min_players": 1,
      "max_players": 4,
      "runtime_contract": {
        "camera": "lane_grid",
