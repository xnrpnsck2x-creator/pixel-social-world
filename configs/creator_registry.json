        "network_profile": "session_sync"
      },
      "capabilities": [
        "cap.tower.wave_spawns",
        "cap.tower.placement",
        "cap.tower.path_grid",
        "cap.tower.upgrade_rules"
      ]
    },
    {
      "id": "battle_royale",
      "public_runtime_enabled": false,
      "min_players": 2,
      "max_players": 16,
      "runtime_contract": {
        "camera": "top_down",
        "input_profile": "survival_action",
        "network_profile": "authoritative_realtime"
      },
      "capabilities": [
        "cap.survival.shrinking_zone",
        "cap.survival.elimination",
        "cap.survival.loot_light",
        "cap.survival.spectator_state"
